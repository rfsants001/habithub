{
  "compilerOptions": {
    // Node 20+ — sem transpilar pra baixo, quem roda é o tsx
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],

    // rigor: pega erro de tipo antes de virar bug em runtime
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    // interop com pacotes CommonJS (ex.: better-sqlite3)
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    // tsc aqui é só type-checker (`npm run typecheck`); não emite JS
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "drizzle.config.ts", "vitest.config.ts"]
}
