#!/usr/bin/env bash
# HabitHub Control — atalho pra TUI.
#   ./scripts/habithub
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v node >/dev/null 2>&1; then
  echo "node não encontrado no PATH." >&2
  exit 1
fi

MAIOR="$(node -p 'process.versions.node.split(".")[0]')"
if [ "$MAIOR" -lt 24 ]; then
  echo "Node >= 24 é necessário (atual: $(node -v))." >&2
  exit 1
fi

exec node "$DIR/tui.mjs" "$@"
